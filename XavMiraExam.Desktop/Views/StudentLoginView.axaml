<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XavMiraExam.Desktop.ViewModels"
             x:Class="XavMiraExam.Desktop.Views.StudentLoginView"
             x:DataType="vm:StudentLoginViewModel">

    <Grid Margin="32" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Login do Aluno"
                       FontSize="24" FontWeight="Bold" />
            <TextBlock Text="{Binding ExamTitle, StringFormat='Prova: {0}'}"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="12" MaxWidth="420">
            <TextBlock Text="Sobrenome" />
            <TextBox Text="{Binding Sobrenome}"
                     Watermark="Ex: Silva"
                     MaxLength="60" />

            <TextBlock Text="Senha" />
            <TextBox Text="{Binding Senha}"
                     PasswordChar="•"
                     Watermark="Senha"
                     MaxLength="64" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Entrar"
                        Command="{Binding IdentifyStudentCommand}" />
                <Button Content="Criar conta"
                        Classes="secondary"
                        Command="{Binding GoToRegisterCommand}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,24,0,0" Spacing="12">
            <Border IsVisible="{Binding IsStudentIdentified}"
                    Padding="16"
                    Background="{StaticResource InfoSurfaceBrush}"
                    BorderBrush="{StaticResource InfoBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    MaxWidth="420">
                <StackPanel Spacing="4">
                    <TextBlock Text="Aluno identificado"
                               Foreground="{StaticResource InfoTextBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StudentName}" FontSize="18" />
                    <TextBlock Text="{Binding StudentTurma, StringFormat='Turma: {0}'}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       MaxWidth="420" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,20,0,0">
            <Button Content="Iniciar prova"
                    Command="{Binding StartExamCommand}"
                    IsEnabled="{Binding IsStudentIdentified}" />
            <Button Content="Voltar"
                    Classes="secondary"
                    Command="{Binding GoBackCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
