<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XavMiraExam.Desktop.ViewModels"
        xmlns:views="using:XavMiraExam.Desktop.Views"
        x:Class="XavMiraExam.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="XavMira Exam System"
        Icon="/Assets/XMES_Logo.ico"
        Width="800" Height="600"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProfessorLoginViewModel">
            <views:ProfessorLoginView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProfessorViewModel">
            <views:ProfessorView />
        </DataTemplate>
        <DataTemplate DataType="vm:StudentLoginViewModel">
            <views:StudentLoginView />
        </DataTemplate>
        <DataTemplate DataType="vm:StudentRegisterViewModel">
            <views:StudentRegisterView />
        </DataTemplate>
        <DataTemplate DataType="vm:ExamViewModel">
            <views:ExamView />
        </DataTemplate>
        <DataTemplate DataType="vm:ExamCompleteViewModel">
            <views:ExamCompleteView />
        </DataTemplate>
    </Window.DataTemplates>

    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
