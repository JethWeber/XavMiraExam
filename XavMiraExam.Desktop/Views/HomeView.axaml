<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XavMiraExam.Desktop.ViewModels"
             x:Class="XavMiraExam.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid Margin="32" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="XavMira Exam System"
                       FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Selecione o modo de utilização"
                       FontSize="14" Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    Spacing="16"
                    MaxWidth="420"
                    HorizontalAlignment="Center">
            <Button Content="Modo Professor"
                    Command="{Binding OpenProfessorModeCommand}"
                    HorizontalAlignment="Stretch"
                    Height="52"
                    FontSize="16" />
            <Button Content="Modo Aluno"
                    Command="{Binding OpenStudentModeCommand}"
                    HorizontalAlignment="Stretch"
                    Height="52"
                    FontSize="16" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="Aplicação offline para realização de provas informatizadas."
                   Opacity="0.6"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
