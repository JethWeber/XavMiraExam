<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XavMiraExam.Desktop.ViewModels"
             x:Class="XavMiraExam.Desktop.Views.ProfessorView"
             x:DataType="vm:ProfessorViewModel">

    <ScrollViewer>
        <Grid Margin="32" RowDefinitions="Auto,Auto,Auto,*,Auto">
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Modo Professor"
                           FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Importar prova, validar e iniciar sessão"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="12">
                <Button Content="Importar ficheiro JSON"
                        Command="{Binding ImportExamCommand}"
                        HorizontalAlignment="Left" />

                <Border IsVisible="{Binding IsExamLoaded}"
                        Padding="16"
                        Background="{StaticResource InfoSurfaceBrush}"
                        BorderBrush="{StaticResource InfoBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding ExamTitle}"
                                   Foreground="{StaticResource InfoTextBrush}"
                                   FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="{Binding QuestionCount, StringFormat='Questões: {0}'}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Tempo por questão (s):" VerticalAlignment="Center" />
                            <NumericUpDown Value="{Binding TempoPorQuestao}"
                                           Minimum="1"
                                           Maximum="3600"
                                           Width="110" />
                        </StackPanel>
                        <TextBlock Text="{Binding NotaMaxima, StringFormat='Nota máxima: {0}'}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding ValidationErrors}"
                              IsVisible="{Binding HasValidationErrors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='• {0}'}"
                                       Foreground="{StaticResource DangerTextBrush}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Grid.Row="2"
                    Margin="0,16,0,0"
                    Padding="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush1}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
            </Border>

            <StackPanel Grid.Row="4"
                        Margin="0,20,0,0"
                        Orientation="Horizontal"
                        Spacing="12">
                <Button Content="Iniciar sessão"
                        Command="{Binding StartSessionCommand}"
                        IsEnabled="{Binding IsExamLoaded}" />
                <Button Content="Modo Aluno"
                        Command="{Binding OpenStudentLoginCommand}"
                        IsEnabled="{Binding IsSessionStarted}" />
                <Button Content="Voltar"
                        Classes="secondary"
                        Command="{Binding GoBackCommand}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
