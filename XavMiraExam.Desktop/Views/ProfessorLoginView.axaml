<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XavMiraExam.Desktop.ViewModels"
             x:Class="XavMiraExam.Desktop.Views.ProfessorLoginView"
             x:DataType="vm:ProfessorLoginViewModel">

    <Grid Margin="32" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Login do Professor"
                       FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Acesso restrito ao formador (Joaquim Santareno)."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="12" MaxWidth="420">
            <TextBlock Text="Utilizador" />
            <TextBox Text="{Binding Username}"
                     Watermark="Utilizador"
                     MaxLength="40" />

            <TextBlock Text="Senha" />
            <TextBox Text="{Binding Password}"
                     PasswordChar="•"
                     Watermark="Senha"
                     MaxLength="64" />

            <Button Content="Entrar"
                    Command="{Binding LoginCommand}"
                    HorizontalAlignment="Left" />
        </StackPanel>

        <Border Grid.Row="2"
                Margin="0,20,0,0"
                Padding="16"
                MaxWidth="420"
                HorizontalAlignment="Left"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush1}"
                BorderThickness="1"
                CornerRadius="8">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,20,0,0">
            <Button Content="Voltar"
                    Classes="secondary"
                    Command="{Binding GoBackCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
